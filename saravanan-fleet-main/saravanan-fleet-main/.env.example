# ══════════════════════════════════════════════════════════════════
#  Saravanan Fleet Management — Environment Variables Reference
#  Copy this file to server/.env and fill in the values.
#  Never commit your actual .env file to version control.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=5001

# ── Google Sheets Database ────────────────────────────────────────
# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# ── Google Service Account Credentials (choose ONE option) ────────

# Option A — Recommended for Render / Vercel / any cloud server:
# Paste the FULL content of your downloaded service-account JSON as one line.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B — Local development only (file path, won't work on cloud servers):
# GOOGLE_CREDENTIALS_PATH=./service-account-key.json

# Option C — Individual fields (alternative to JSON):
# GOOGLE_CLIENT_EMAIL=fleet-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── CORS ──────────────────────────────────────────────────────────
# Set to your Vercel frontend URL to restrict API access in production.
# Leave blank (or unset) to allow all origins during local development.
# Example: https://saravanan-fleet.vercel.app
CLIENT_ORIGIN=

# ── Sync Polling ──────────────────────────────────────────────────
# How often (in milliseconds) the backend syncs with Google Sheets.
SYNC_INTERVAL_MS=20000
